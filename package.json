{
  "name": "future-css",
  "version": "0.0.0",
  "description": "A styling system for multi-language, multi-platform systems",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "style": "./dist/future-css.css",
      "default": "./dist/index.js"
    },
    "./layers": "./dist/layers.css",
    "./reset": "./dist/reset.css",
    "./tokens": "./dist/tokens.css",
    "./base": "./dist/base.css",
    "./layout": "./dist/layout.css",
    "./components/*": "./dist/components/*.css",
    "./utilities": "./dist/utilities.css",
    "./package.json": "./package.json",
    "./js": "./src/js/accelerator.ts"
  },
  "files": [
    "dist",
    "src/js"
  ],
  "scripts": {
    "build": "npm run build:css && npm run build:wasm",
    "build:tokens": "node src/build/compile-tokens.ts",
    "check": "npm run build && npm run lint && npm run test && npm run test:rust",
    "lint": "node tools/lint-css.mjs",
    "test": "node --test \"tests/**/*.test.ts\"",
    "clean": "node -e \"import('node:fs').then(fs=>fs.rmSync('dist',{recursive:true,force:true}))\"",
    "build:wasm": "node src/build/build-wasm.ts",
    "test:rust": "cargo test",
    "build:css": "node src/build/build.ts"
  },
  "keywords": [
    "css",
    "design-system",
    "design-tokens",
    "dark-mode",
    "rtl",
    "i18n",
    "accessibility"
  ],
  "publishConfig": {
    "access": "public"
  }
}
